-- [[ LISTENER DE CHAT ]]
-- Como você é o dono, o script monitora o SEU chat
MY_PLAYER.Chatted:Connect(function(msg)
    if MY_PLAYER.UserId ~= OWNER_ID then return end -- Trava de segurança máxima

    if msg:sub(1,1) == PREFIX then
        local split = msg:sub(2):split(" ")
        local cmdName = split[1]:lower()
        local args = {unpack(split, 2)}

        if commands[cmdName] then
            pcall(function()
                commands[cmdName](args)
            end)
        end
    end
end)

