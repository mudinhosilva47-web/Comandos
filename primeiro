local PREFIX = ":"

-- [[ SINAL VISUAL DE CARREGAMENTO ]]
local function createTestButton()
    local sg = Instance.new("ScreenGui")
    sg.Name = "OmniTestUI"
    sg.Parent = CoreGui
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 50)
    btn.Position = UDim2.new(0.5, -100, 0.1, 0) -- Topo da tela
    btn.BackgroundColor3 = Color3.fromRGB(0, 255, 127) -- Verde Neon
    btn.Text = "OMNI LOADED (Click to Close)"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.Secondary
    btn.TextSize = 18
    btn.Parent = sg
    
    -- Efeito de arredondar
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        sg:Destroy()
        print("Botão de teste fechado.")
    end)
end

-- Só executa se for você
if LP.UserId == OWNER_ID then
    createTestButton()
    print("OMNI-SYSTEM: Verificado com sucesso.")
else
    warn("OMNI-SYSTEM: Usuario nao autorizado.")
    return
